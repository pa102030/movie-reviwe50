
/* =========================================================
   MOVIES WORLD - Responsive Navigation Fix
   Add AFTER css/style.css in every HTML page.
   ========================================================= */

html, body {
  max-width: 100%;
  overflow-x: hidden;
}

* {
  box-sizing: border-box;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
}

.header-inner {
  width: min(100%, 1500px);
  margin: 0 auto;
  padding-inline: clamp(14px, 2vw, 28px);
  display: flex;
  align-items: center;
  gap: 18px;
  min-width: 0;
}

.logo {
  flex: 0 0 auto;
  white-space: nowrap;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: clamp(10px, 1.2vw, 22px);
  flex: 1 1 auto;
  min-width: 0;
}

.main-nav a {
  white-space: nowrap;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
  min-width: 0;
}

.hamburger {
  display: none !important;
  cursor: pointer;
}

/* Make the existing hamburger a real menu button. */
@media (max-width: 1180px) {
  .main-nav {
    display: none !important;
  }

  .header-actions {
    margin-left: auto;
  }

  .hamburger {
    display: inline-flex !important;
  }

  .btn-profile span {
    display: none;
  }
}

/* Smaller laptops / tablets */
@media (max-width: 900px) {
  .header-inner {
    gap: 8px;
  }

  .logo {
    font-size: clamp(16px, 3vw, 21px);
  }

  .logo-mark {
    width: 34px;
    height: 34px;
  }

  .header-actions {
    gap: 5px;
  }

  .header-actions .icon-btn,
  .header-actions .btn-profile {
    min-width: 40px;
    min-height: 40px;
  }

  /* Search button stays available, but the search field itself should not
     force the header wider than the viewport. */
  [data-search-input],
  .search-input {
    max-width: 100%;
  }
}

/* Phones */
@media (max-width: 600px) {
  .site-header {
    min-height: 62px;
  }

  .header-inner {
    min-height: 62px;
    padding-inline: 10px;
  }

  .logo {
    font-size: 17px;
  }

  .logo-mark {
    width: 32px;
    height: 32px;
  }

  .header-actions .btn-profile {
    display: none !important;
  }

  .header-actions .icon-btn {
    width: 38px;
    height: 38px;
    padding: 0;
  }

  .hero,
  .hero-bg,
  .hero-overlay {
    max-width: 100vw;
  }

  .hero-content {
    width: 100%;
    padding: 80px 16px 30px;
  }

  .hero-content h1,
  .hero-title {
    font-size: clamp(30px, 9vw, 48px);
    line-height: 1.03;
  }

  .hero-description {
    font-size: 14px;
    line-height: 1.55;
    max-width: 100%;
  }

  .hero-buttons,
  .hero-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .hero-buttons .btn,
  .hero-actions .btn {
    width: 100%;
  }
}

/* =========================================================
   Mobile menu generated by responsive-nav.js
   ========================================================= */

.mw-mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: none;
  background: rgba(5, 7, 11, .98);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  overflow-y: auto;
  padding: 78px 18px 28px;
}

.mw-mobile-menu.is-open {
  display: block;
}

.mw-mobile-menu__inner {
  width: min(100%, 520px);
  margin: 0 auto;
}

.mw-mobile-menu__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.mw-mobile-menu__title {
  color: #fff;
  font-size: 18px;
  font-weight: 800;
}

.mw-mobile-menu__close {
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 12px;
  background: rgba(255,255,255,.06);
  color: #fff;
  cursor: pointer;
  font-size: 18px;
}

.mw-mobile-menu a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 52px;
  padding: 12px 14px;
  margin: 7px 0;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 12px;
  color: #fff;
  text-decoration: none;
  background: rgba(255,255,255,.045);
  font-weight: 700;
}

.mw-mobile-menu a:hover,
.mw-mobile-menu a:focus-visible {
  background: rgba(229, 9, 20, .16);
  border-color: rgba(229, 9, 20, .55);
}

.mw-mobile-menu__section {
  margin-top: 18px;
  margin-bottom: 8px;
  color: #aeb5c2;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
}

body.mw-menu-open {
  overflow: hidden;
}

@media (min-width: 1181px) {
  .mw-mobile-menu {
    display: none !important;
  }
}
